classDiagram
%% Paquete personas
    namespace personas {

        class Persona{
            <<abstract>>
            -String nombre
            -String apellido
            -String telefono
            -String correo
            +Persona(nombre : String, apellido : String, telefono : String, correo : String)
            +getNombre() String
            +getApellido() String
            +getTelefono() String
            +getCorreo() String
            +setNombre(nombre : String) void
            +setApellido(apellido : String) void
            +setTelefono(telefono : String) void
            +setCorreo(correo : String) void
            +describirFuncion()*  void
        }
        class Propietario{
            -String direccion
            -List~Mascota~ mascotas
            +Propietario(nombre : String, apellido : String, telefono : String, correo : String, direccion : String )
            +describirFuncion()void
            +setDireccion(direccion : String)  void
            +agregarMascota(mascota : Mascota)  void
            +getMascotas() List mascotas
            +toString()
        }
        class Veterinario{
            -String cedulaProfesional
            -String especialidad
            +Veterinario(nombre : String, apellido : String, telefono : String, correo : String, cedulaProfesional : String, especialidad : String)
            +describirFuncion() : void
            +toString()
        }
        class Recepcionista{
            -String turno
            +Recepcionista(nombre : String, apellido : String, telefono : String, correo : String, turno : String)
            +describirFuncion() void
            +setTurno(turno : String)  void
            +toString()
        }
    }

    namespace mascotas {
        class Mascota{
            <<abstract>>
            -String nombre
            -int edad
            -float peso
            -Propietario propietario
            -HistorialCLinico historialClinico
            +Mascota(nombre : String, edad : int, peso : float, propietario : Propietario)
            +getHistorialClinico() HistorialCLinico
            +emitirSonido()* void
        }
        class Perro{
            -String raza
            -int nivelEnergia
            +Perro(nombre : String,edad : int, peso : float, propietario : Propietario, raza : String, nivelEnergia : int)
            +emitirSonido() void
        }
        class Gato{
            -boolean esDomestico
            +Gato(nombre : String,edad : int, peso : float, propietario : Propietario, esDomestico : boolean)
            +emitirSonido() void
        }
        class AveExotica{
            -float longitudAlas
            +AveExotica(nombre : String,edad : int, peso : float, propietario : Propietario,longitudAlas : float)
            +emitirSonido() void
        }
    }

    namespace servicios {

        class Facturable{
            <<interface>>
            +calcularCosto() double
        }

        class ConsultaGeneral{
            -double tarifaBase
            +ConsultaGeneral(tarifaBase : double)
            +setTarifaBase(tarifaBase : double)  void
            +calcularCosto() double
        }

        class Vacunacion{
            -double costoVacuna
            -double costoAplicacion
            +Vacunacion(costoVacuna : double, costoAplicacion : double)
            +setCostoVacuna(costoVacuna : double) : void
            +setCostoAplicacion(costoAplicacion : double) : void
            +calcularCosto() double
        }

        class Cirugia{
            -int complejidad
            -int horasQuirofano
            +Cirugia(complejidad : int, horasQuirofano : int)
            +getHorasQuirofano() int
            +getcomplejidad() int
            +calcularCosto() double
        }
    }

    namespace clinica {
        class HistorialClinico{
            -List~Cita~ citasAtendidas
            +HistorialClinico()
            +agregarCita(cita : Cita) void
            +getCitas() List citasAtendidas
        }
        class Clinica{
            -String nombre
            -List~Consultorio~ consultorios
            -List~Veterinario~ veterinarios
            -List~Propietario~ propietarios
            -List~Comprobante~ comprobantes
            +Clinica(nombre : String)
            +agregarConsultorio(numero : int)  void
            +agregarVeterinario(veterinario : Veterinario) void
            +getVeterinario() List Veterinarios
            +agregarComprobante(comprobante : Comprobante) void
        }
        class Consultorio{
            -int numero
            +Consultorio(numero : int)
        }
        class Cita{
            -LocalDate fecha
            -LocalTime hora
            -Mascota mascota
            -Veterinario veterinario
            -consultorio Consultorio
            -estado Estado
            -Facturable servicio
            +Cita(fecha : LocalDate, hora : LocalTime,mascota : Mascota, veterinario : Veterinario, consultorio : Consultorio)
            +atenderCita(servicio : Facturable) void
            +cancelarCita() : void
        }
        class Estado{
            <<enumeration>>
            PROGRAMADA
            ATENDIDA
            CANCELADA
        }
        class Comprobante {
            -Cita cita
            -int total
            int$ totalComprobantes
            +Comprobante(cita : Cita)
            +getTotalComprobante() int$
            +getCita() Cita

        }


    }
    namespace app {
        class Main{
            +main(args : String[]) void
        }

    }

%%Herencias

    Persona <|-- Propietario
    Persona <|-- Veterinario
    Persona <|--Recepcionista
    Mascota <|-- Perro
    Mascota <|-- Gato
    Mascota <|-- AveExotica
    Facturable <|.. ConsultaGeneral
    Facturable <|.. Vacunacion
    Facturable <|.. Cirugia

%%relacion

%%Asosiaciones
    Cita "0..*" --> "1" Mascota : Asociación
    Cita "0..*" --> "1" Veterinario : Asociación
    Cita "0..*" --> "1" Consultorio : Asociación
    Cita "1" --> "0..1" Facturable : Asociación
    Cita --> Estado : Estado
    Comprobante "1" --> "1" Cita : Asociación
    Clinica "1" --> "0..*" Comprobante : Asociación

%%Agregaciones
    Cita "0..*" --o "1" HistorialClinico : Agregación
    Cita "0..*" --o "1" Clinica : Agregación
    Propietario "0..*" --o "1" Clinica : Agregación
    Veterinario "1..*" --o "1" Clinica : Agregación
    Mascota "0..*" --o "1" Propietario : Agregacion

%%Composiciones
    Consultorio "1..*" --* "1" Clinica : Composición
    HistorialClinico "1" --* "1" Mascota : Composición

    Main ..> Clinica : Usa

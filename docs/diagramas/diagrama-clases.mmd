classDiagram

    namespace personas {
        class Persona {
            <<abstract>>
            -String nombre
            -String apellido
            -String telefono
            -String correo
            +Persona(nombre : String, apellido : String, telefono : String, correo : String)
            +getTelefono() String
            +describirFuncion()* void
        }

        class Propietario {
            -String direccion
            -List~Mascota~ mascotas
            +Propietario(direccion : String)
            +describirFuncion() void
            +setDireccion(direccion : String) void
            +agregarMascota(mascota : Mascota) void
            +eliminarMascota(mascota : Mascota) void
            +getMascotas() List~Mascota~
            +toString() String
        }

        class Veterinario {
            -String cedulaProfesional
            -String especialidad
            +Veterinario(cedulaProfesional : String, especialidad : String)
            +getCedulaProfesional() String
            +describirFuncion() void
            +toString() String
        }

        class Recepcionista {
            -String turno
            +Recepcionista(turno : String)
            +describirFuncion() void
            +setTurno(turno : String) void
            +toString() String
        }
    }

    namespace mascotas {
        class Mascota {
            <<abstract>>
            -String nombre
            -int edad
            -float peso
            -Propietario propietario
            -HistorialClinico historialClinico
            +Mascota(nombre : String, edad : int, peso : float, propietario : Propietario)
            +getNombre() String
            +getPropietario() Propietario
            +getHistorialClinico() HistorialClinico
            +emitirSonido()* void
        }

        class Perro {
            -String raza
            -int nivelEnergia
            +Perro(nombre : String, edad : int, peso : float, raza : String, nivelEnergia : int)
            +emitirSonido() void
        }

        class Gato {
            -boolean esDomestico
            +Gato(nombre : String, edad : int, peso : float, esDomestico : boolean)
            +emitirSonido() void
        }

        class AveExotica {
            -float longitudAlas
            +AveExotica(nombre : String, edad : int, peso : float, longitudAlas : float)
            +emitirSonido() void
        }
    }

    namespace servicios {
        class Facturable {
            <<interface>>
            +calcularCosto() double
        }

        class ConsultaGeneral {
            -double tarifaBase
            +ConsultaGeneral(tarifaBase : double)
            +setTarifaBase(tarifaBase : double) void
        }

        class Vacunacion {
            -double costoVacuna
            -double costoAplicacion
            +Vacunacion(costoVacuna : double)
            +setCostoVacuna(costoVacuna : double) void
        }

        class Cirugia {
            -String complejidad
            -int horasQuirofano
            +Cirugia(complejidad : String, horasQuirofano : int)
        }
    }

    namespace clinica {
        class Estado {
            <<enumeration>>
            PROGRAMADA
            ATENDIDA
            CANCELADA
        }

        class HistorialClinico {
            -List~Cita~ citasAtendidas
            +HistorialClinico()
            +agregarCita(cita : Cita) void
            +getCitas() List~Cita~
        }

        class Clinica {
            -String nombre
            -List~Consultorio~ consultorios
            -List~Veterinario~ veterinarios
            -List~Propietario~ propietarios
            -List~Comprobante~ comprobantes
            -List~Cita~ citas
            +Clinica(nombre : String)
            +getNombre() String
            +agregarConsultorio(numero : int) void
            +agregarVeterinario(veterinario : Veterinario) void
            +agregarPropietario(propietario : Propietario) void
            +agendarCita(cita : Cita) void
            +atenderCita(cita : Cita, servicio : Facturable) void
            +agregarComprobante(comprobante : Comprobante) void
            +calcularTotalCobrado(veterinario : Veterinario) double
            +calcularTotalCobrado(mascota : Mascota) double
            +obtenerMascotas() List~Mascota~
            +darBajaMascota(mascota : Mascota) void
            +buscarConsultorio(numero : int) Consultorio
            +buscarVeterinario(cedula : String) Veterinario
            +buscarMascota(nombre : String) Mascota
            +buscarPropietario(telefono : String) Propietario
            +obtenerVeterinarios() List~Veterinario~
            +obtenerPropietarios() List~Propietario~
            +obtenerCitas() List~Cita~
            -mismoVeterinario(a : Veterinario, b : Veterinario) boolean
            -veterinarioOcupado(veterinario : Veterinario, fecha : LocalDate, hora : LocalTime) boolean
            -consultorioOcupado(consultorio : Consultorio, fecha : LocalDate, hora : LocalTime) boolean
            -sumarCostosServicios(servicios : List~Facturable~) double
        }

        class Consultorio {
            -int numero
            +Consultorio(numero : int)
            +getNumero() int
        }

        class Cita {
            -LocalDate fecha
            -LocalTime hora
            -Mascota mascota
            -Veterinario veterinario
            -Consultorio consultorio
            -Estado estado
            -Facturable servicio
            +Cita(fecha : LocalDate, hora : LocalTime, mascota : Mascota, veterinario : Veterinario, consultorio : Consultorio)
            +setFecha(fecha : LocalDate) void
            +setHora(hora : LocalTime) void
            +setMascota(mascota : Mascota) void
            +setVeterinario(veterinario : Veterinario) void
            +setConsultorio(consultorio : Consultorio) void
            +atenderCita(servicio : Facturable) void
            +cancelarCita() void
            +getFecha() LocalDate
            +getHora() LocalTime
            +getMascota() Mascota
            +getVeterinario() Veterinario
            +getConsultorio() Consultorio
            +getEstado() Estado
            +getServicio() Facturable
        }

        class Comprobante {
            -Cita cita
            -double total
            -static double totalComprobantes
            +getTotal() double
            +getCita() Cita
        }
    }

%% Herencia
    Persona <|-- Propietario
    Persona <|-- Veterinario
    Persona <|-- Recepcionista

    Mascota <|-- Perro
    Mascota <|-- Gato
    Mascota <|-- AveExotica

    Facturable <|.. ConsultaGeneral
    Facturable <|.. Vacunacion
    Facturable <|.. Cirugia

%% Relaciones
    Mascota "0..*" --o "1" Propietario : Agregación
    Cita "0..*" --> "1" Mascota : Asociación
    Cita "0..*" --> "1" Veterinario : Asociación
    Cita "0..*" --> "1" Consultorio : Asociación
    Cita "1" --> "0..1" Facturable : Asociación
    Comprobante "1" --> "1" Cita : Asociación
    Cita "0..*" --o "1" HistorialClinico : Agregación
    Cita "0..*" --o "1" Clinica : Agregación
    Propietario "0..*" --o "1" Clinica : Agregación
    Clinica "1" --> "0..*" Comprobante : Asociación
    Veterinario "1..*" --o "1" Clinica : Agregación
    Consultorio "1..*" --* "1" Clinica : Composición
    HistorialClinico "1" --* "1" Mascota : Composición